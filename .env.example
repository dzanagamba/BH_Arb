# Server settings
HOST=0.0.0.0
PORT=8000

# Scraper settings (set to False to see browser window for CAPTCHA solving)
# HEADLESS=False

# Verify TLS certificates on direct httpx API calls (default: off)
# VERIFY_SSL=true

# Optional API key — when set, POST /api/scan, /api/config/toggle, /api/recalculate,
# /api/verify and GET /api/history require an `X-API-Key` header.
# API_KEY=change-me

# Rate limit for triggering scans: max scans per minute per client (default 3)
# SCAN_RATE_LIMIT=3
