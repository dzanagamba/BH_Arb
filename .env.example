# Server settings
# Loopback by default. Set 0.0.0.0 only behind a firewall/API key.
HOST=127.0.0.1
PORT=8000
# DEBUG, INFO, WARNING or ERROR (default INFO)
# LOG_LEVEL=INFO
# text (readable) or json (one JSON object per line; both carry request ids)
# LOG_FORMAT=text

# Scraper settings (set to False to see browser window for CAPTCHA solving)
# HEADLESS=False

# Verify TLS certificates on direct httpx API calls (default: off)
# VERIFY_SSL=true
# Outgoing ceiling per bookmaker in requests per second, retries included
# (default 5; 0 disables it). Lower it if a book starts returning 429.
# SCRAPER_REQUESTS_PER_SECOND=5
# Per-book overrides of that ceiling, as "book=rate" pairs. Mozzartbet is at
# 60/s because its per-event full offer (SR7-1) is otherwise rate-bound.
# SCRAPER_BOOK_RATES=mozzartbet=60
# One adapter's budget in seconds (default 240): an overrunning book is reported
# timeout and missing from the scan, the others still price.
# SCRAPER_BOOK_TIMEOUT_SECONDS=240
# Budget for the whole scraping phase in seconds (default 600): stragglers are
# cancelled (browser closed) and the scan prices what already returned.
# SCRAPER_SCAN_TIMEOUT_SECONDS=600

# Optional API key — when set, every /api route except /api/health requires an
# `X-API-Key` header; the dashboard asks for it once per tab.
# API_KEY=change-me

# Rate limit for triggering scans: max scans per minute per client (default 3)
# SCAN_RATE_LIMIT=3
# On-demand surebet re-verifications per minute per client (default 10; 0 off).
# VERIFY_RATE_LIMIT=10
# Human mapping is disabled by default; the evidence ledger is the trust source.
# Set true only for a migration, never for normal operation.
# HUMAN_MAPPING_ENABLED=false

# Scheduled scans (0 = off). Prematch is the production feed; live is deferred.
# AUTO_SCAN_PREMATCH_MINUTES=10
# AUTO_SCAN_LIVE_MINUTES=0
# Scheduled-scan circuit breaker: open a book after N consecutive failures and
# cap the doubling cooldown. `blocked`/`429` open it immediately with a longer
# cooldown; a parser error never opens it.
# BOOK_BACKOFF_AFTER_FAILURES=3
# BOOK_BACKOFF_MAX_MINUTES=60
# Drop a surebet whose leg is a price outlier against the other books.
# PRICE_GUARD_ENABLED=true

# Operator alerts (P1-5). Empty means no alert transport.
# A generic webhook receives one JSON POST per alert.
# ALERT_WEBHOOK_URL=https://example.invalid/bh-arb
# Telegram: set both the bot token and the chat id.
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Alert only at or above this profit percentage (default 3.0).
# ALERT_MIN_PROFIT_PERCENT=3.0
# One alert per event signature per window (default 60 minutes).
# ALERT_DEDUPE_MINUTES=60
# Delivery retries, off the scan path (defaults 3 attempts, 1s base).
# ALERT_RETRY_ATTEMPTS=3
# ALERT_RETRY_BASE_SECONDS=1.0

# Soft resource budget reported by /api/health and alerted after a scan (P1-6).
# RSS_BUDGET_MB=1024

# Advisory per-book stake ceiling shown by the slip (P3-3). The default comes
# from config/bookmaker_risk.json (P3-6); it never blocks a bet or a scan.
# BOOK_MAX_STAKE_MBET=500
# BOOK_MAX_STAKE_WWIN=500
